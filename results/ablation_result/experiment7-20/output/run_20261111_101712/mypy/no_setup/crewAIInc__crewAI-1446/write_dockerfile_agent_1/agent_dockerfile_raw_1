<dockerfile>
# Use Ubuntu 22.04 as base image with bash shell environment
FROM --platform=linux/x86_64 ubuntu:22.04
ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
SHELL ["/bin/bash", "-c"]

# Install essential system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    build-essential \
    ca-certificates \
    libffi-dev \
    libssl-dev \
    python3.11 \
    python3.11-venv \
    python3.11-distutils \
    python3-pip \
    python3-setuptools \
    locales-all \
    tzdata \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Set python3 to point to python3.11 (default)
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

# Upgrade pip to latest version
RUN python3 -m pip install --upgrade pip

# Set working directory
WORKDIR /testbed/

# Clone the repository and checkout the specific commit SHA
RUN git clone https://github.com/crewAIInc/crewAI.git /testbed && \
    cd /testbed && \
    git reset --hard 916dec241836cb85c4eda5c8a4e1e0c00aa6c802 && \
    git remote remove origin

# Create and activate virtual environment, then install dependencies and the package in editable mode
RUN python3 -m venv testbed && \
    source testbed/bin/activate && \
    pip install --upgrade pip && \
    # Install crewai with tools extras per context instructions using pip install with editable flag
    pip install 'crewai[tools]' || true && \
    # Install the local package code in editable mode instead of installing from PyPI
    pip install -e . && \
    # Run environment setup commands as per context retrieval agent instructions
    uv lock || true && \
    uv sync || true && \
    uv venv || true && \
    pip install dist/*.tar.gz || true && \
    pre-commit install || true && \
    crewai install || true

# Export environment variables placeholder (Note: actual keys expected to be set via .env for runtime)
ENV OPENAI_API_KEY=""
ENV SERPER_API_KEY=""

# Add source of virtual environment activation to bashrc
RUN echo "source /testbed/testbed/bin/activate" >> /root/.bashrc

# Set default shell to bash explicitly
SHELL ["/bin/bash", "-l", "-c"]

# Keep working directory at /testbed
WORKDIR /testbed/
</dockerfile>