<dockerfile>
FROM --platform=linux/x86_64 ubuntu:22.04
ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
SHELL ["/bin/bash", "-c"]

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    build-essential \
    python3.9 \
    python3.9-venv \
    python3.9-distutils \
    python3-pip \
    locales \
    locales-all \
    npm \
    && rm -rf /var/lib/apt/lists/*

# Ensure python3 points to python3.9
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.9 1

# Upgrade pip
RUN python3 -m pip install --upgrade pip

# Install playwright dependencies and playwright itself
RUN python3 -m pip install playwright && playwright install --with-deps

# Install mermaid-cli globally via npm
RUN npm install -g @mermaid-js/mermaid-cli

WORKDIR /testbed/

# Clone the target repository and checkout the specific commit
ARG COMMIT_SHA=5e8bd105177e08848990d32b9ea636daa639be19
RUN git clone https://github.com/FoundationAgents/MetaGPT.git /testbed/ && \
    cd /testbed/ && \
    git reset --hard ${COMMIT_SHA}

# Create and activate python virtual environment, install package and test dependencies
RUN python3 -m venv /testbed/testbed && \
    source /testbed/testbed/bin/activate && \
    pip install --upgrade pip && \
    pip install -e .[test]

# Ensure metagpt config initialization directory exists (no config file created as it requires CLI command and user interaction)
RUN mkdir -p /root/.metagpt

# Add virtual environment activation to bashrc
RUN echo "source /testbed/testbed/bin/activate" >> /root/.bashrc

ENV ALLOW_OPENAI_API_CALL=0
ENV PATH="/testbed/testbed/bin:$PATH"

# Set default shell to bash for later container usage
CMD ["/bin/bash"]
</dockerfile>