    - name: Install Dev Dependencies
      run: |
        pip install -q -e .[dev]
        pip install coverage pytest
    - name: Run tests with coverage
      run: |
        coverage run -m pytest tests
    - name: Generate coverage report
      run: |
        coverage report -m
