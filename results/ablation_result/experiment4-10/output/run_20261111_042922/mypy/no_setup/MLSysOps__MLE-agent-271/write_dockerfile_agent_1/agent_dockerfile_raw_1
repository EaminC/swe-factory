<dockerfile>
# Use Ubuntu 20.04 LTS as base image (as per CI environment)
FROM --platform=linux/x86_64 ubuntu:20.04
ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Install system dependencies and essential tools
RUN apt-get update && apt-get install -y \
    git \
    wget \
    curl \
    build-essential \
    python3 \
    python3-venv \
    python3-pip \
    python3-setuptools \
    locales \
    locales-all \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Create and activate python virtual environment named testbed
RUN python3 -m venv /opt/testbed

# Upgrade pip in the virtual environment
RUN /opt/testbed/bin/pip install --upgrade pip setuptools

# Set environment variables to use the virtual environment by default
ENV VIRTUAL_ENV=/opt/testbed
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Clone the repository and checkout the specific commit
RUN git clone https://github.com/MLSysOps/MLE-agent /testbed \
    && cd /testbed \
    && git reset --hard b9765e74d8c3e87ba6828fc7f9fc7fe751ef7984 \
    && git remote remove origin

WORKDIR /testbed

# Install Python dependencies and the package itself in editable mode
# Install pinned dependencies from requirements.txt with versions as per collected info
# As no exact requirement to install system packages listed in requirements.txt needed,
# just use pip install -r requirements.txt

RUN pip install -r requirements.txt \
    && pip install -e .

# Set default shell to bash
SHELL ["/bin/bash", "-c"]
</dockerfile>