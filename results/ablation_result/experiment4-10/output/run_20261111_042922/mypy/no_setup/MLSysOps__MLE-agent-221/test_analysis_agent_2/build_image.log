2026-11-11 04:35:03,486 - INFO - Building image mlsysops__mle-agent-221
Using dockerfile:
FROM --platform=linux/x86_64 ubuntu:20.04
ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
SHELL ["/bin/bash", "-c"]

# Install essential tools and add Deadsnakes PPA for Python 3.11
RUN apt-get update && apt-get install -y \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa -y && apt-get update && \
    apt-get install -y \
    git \
    wget \
    build-essential \
    curl \
    ca-certificates \
    tzdata \
    locales \
    libffi-dev \
    python3.11 \
    python3.11-venv \
    && rm -rf /var/lib/apt/lists/*

# Install python3.11-distutils via get-pip or fallback to install from python3.11 source since distutils package is not always available
RUN python3.11 -m ensurepip || true

# Upgrade pip
RUN python3.11 -m pip install --upgrade pip setuptools wheel

# Fix for missing distutils if needed (install python3.11-distutils from ppa or via pip setuptools wheel usually sufficient)
# Create virtual environment named testbed
RUN python3.11 -m venv /opt/testbed

# Add virtualenv python and pip to PATH
ENV PATH="/opt/testbed/bin:$PATH"

# Upgrade pip and setuptools in virtual environment
RUN pip install --upgrade pip setuptools

WORKDIR /testbed/

# Clone the repository and checkout the specified commit SHA
RUN git clone https://github.com/MLSysOps/MLE-agent.git /testbed && \
    cd /testbed && \
    git checkout 1b637bed35ef1171f3eb11395c8a5ad2bd8c15b8

# Install the repository dependencies and install in editable mode
RUN pip install --no-cache-dir -e .

# Expose shell environment with virtualenv activated by default
RUN echo "source /opt/testbed/bin/activate" >> /root/.bashrc

