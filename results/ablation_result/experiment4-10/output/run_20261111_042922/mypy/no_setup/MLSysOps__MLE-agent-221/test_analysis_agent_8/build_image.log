2026-11-11 05:28:04,698 - INFO - Building image mlsysops__mle-agent-221
Using dockerfile:
FROM --platform=linux/x86_64 ubuntu:22.04
ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
SHELL ["/bin/bash", "-c"]

# Install system dependencies, Python 3.11, and python3-pip
RUN apt-get update && apt-get install -y \
    git \
    wget \
    build-essential \
    curl \
    ca-certificates \
    tzdata \
    locales \
    libffi-dev \
    python3.11 \
    python3.11-venv \
    python3.11-distutils \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Set python3 alternative only if needed (optional on Ubuntu 22.04 as python3 already points to python3.11)
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 || true

# Upgrade pip, setuptools, and wheel using pip3 (system-wide)
RUN pip3 install --upgrade pip setuptools wheel

# Create a virtual environment named testbed using python3.11
RUN python3.11 -m venv /opt/testbed

# Add virtualenv python and pip to PATH
ENV PATH="/opt/testbed/bin:$PATH"

# Upgrade pip and setuptools within the virtual environment
RUN pip install --upgrade pip setuptools wheel

WORKDIR /testbed/

# Clone the repository and checkout the specified commit SHA
RUN git clone https://github.com/MLSysOps/MLE-agent.git /testbed && \
    cd /testbed && \
    git checkout 1b637bed35ef1171f3eb11395c8a5ad2bd8c15b8

# Install the repository dependencies and install in editable mode
RUN pip install --no-cache-dir -e . 

# Install unittest dependencies - none specified explicitly but include setuptools to ensure test support
# Note: unittest is part of the standard library, no extra packages required.

# Expose shell environment with virtualenv activated by default
RUN echo "source /opt/testbed/bin/activate" >> /root/.bashrc

