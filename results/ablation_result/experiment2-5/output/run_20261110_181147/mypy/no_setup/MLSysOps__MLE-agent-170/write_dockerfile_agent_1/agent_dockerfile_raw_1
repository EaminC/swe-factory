<dockerfile>
FROM --platform=linux/x86_64 ubuntu:20.04
ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
SHELL ["/bin/bash", "-c"]

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    wget \
    build-essential \
    ca-certificates \
    curl \
    tzdata \
    locales \
    python3.11 \
    python3.11-venv \
    python3.11-distutils \
    && rm -rf /var/lib/apt/lists/*

# Install pip for python3.11
RUN curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11 -

# Setup locale and timezone
RUN locale-gen en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

# Create virtual environment for isolation
RUN python3.11 -m venv /opt/testbed

ENV PATH="/opt/testbed/bin:$PATH"

# Upgrade pip, setuptools to ensure latest packaging but keep setuptools at least 38.6.0
RUN pip install --upgrade pip setuptools>=38.6.0

WORKDIR /testbed/

# Clone the target repository and checkout specific commit SHA
# Use HTTPS clone to avoid ssh issues in build environment; the user input was git@ but HTTPS is more reliable in general builds
RUN git clone https://github.com/MLSysOps/MLE-agent.git /testbed && \
    git checkout 38385de9d345570271e1fc92119630fe3e3886dc

# Install the project dependencies in editable mode, including requirements.txt
RUN pip install -r requirements.txt && \
    pip install -e .

# Keep bash fully functional with conda-like activation style
RUN echo "source /opt/testbed/bin/activate" >> /root/.bashrc
</dockerfile>