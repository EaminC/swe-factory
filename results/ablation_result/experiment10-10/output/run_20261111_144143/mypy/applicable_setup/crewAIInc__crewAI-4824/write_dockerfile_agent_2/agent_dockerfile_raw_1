<dockerfile>
# Use Ubuntu 22.04 as base image for a stable, bash-included environment
FROM --platform=linux/x86_64 ubuntu:22.04
ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
SHELL ["/bin/bash", "-c"]

# Add deadsnakes PPA for Python 3.13 packages, then install system dependencies including python3.13 and related packages, rust etc.
RUN apt-get update && apt-get install -y \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa -y \
    && apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    build-essential \
    libssl-dev \
    libffi-dev \
    libsqlite3-dev \
    rustc \
    cargo \
    python3.13 \
    python3.13-venv \
    python3.13-distutils \
    python3.13-dev \
    python3-pip \
    python3-setuptools \
    locales-all \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Make python3 point to python3.13 explicitly, upgrade pip, setuptools and wheel for python3.13
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.13 1 && \
    python3 -m pip install --upgrade pip setuptools wheel

# Install uv CLI tool (CrewAI's environment manager)
RUN python3 -m pip install uv

# Set working directory
WORKDIR /testbed/

# Clone the target repository and checkout specific commit SHA (as argument to docker build)
ARG REPO=https://github.com/crewAIInc/crewAI.git
ARG COMMIT_SHA=542afe61a8adfca1b9a0434189b9f339dfb07817
RUN git clone ${REPO} . && \
    git reset --hard ${COMMIT_SHA}

# Create UV-managed virtual environment and install the local repository plus optional 'tools' dependencies in editable mode
RUN /bin/bash -c "\
    uv venv && \
    source .venv/bin/activate && \
    uv pip install --upgrade pip && \
    uv pip install 'crewai[tools]' && \
    uv pip install -e . \
    "

# Set environment variable for unbuffered Python output
ENV PYTHONUNBUFFERED=1

# Append environment activation to root bashrc for convenience if interactive shell is used
RUN echo "source /testbed/.venv/bin/activate" >> /root/.bashrc

# Default shell explicitly bash
SHELL ["/bin/bash", "-c"]
</dockerfile>