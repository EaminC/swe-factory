<dockerfile>
# Use Ubuntu 20.04 as base image to match CI environment and ensure bash support
FROM --platform=linux/x86_64 ubuntu:20.04

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
SHELL ["/bin/bash", "-c"]

# Install system dependencies: add deadsnakes PPA for python3.11, git, pip, build essentials, curl, etc.
RUN apt-get update && apt-get install -y software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y \
        python3.11 \
        python3.11-venv \
        python3.11-distutils \
        python3.11-dev \
        git \
        wget \
        build-essential \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Set python3 and pip alternatives to python3.11 and install pip for python3.11
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
    && wget https://bootstrap.pypa.io/get-pip.py -O get-pip.py \
    && python3 get-pip.py \
    && rm get-pip.py

# Create a python virtual environment named testbed and prepare PATH
RUN python3 -m venv /opt/testbed
ENV PATH="/opt/testbed/bin:$PATH"

# Set working directory before cloning the repo
WORKDIR /testbed/

# Clone the target repository and checkout specific commit SHA supplied as build argument
ARG COMMIT_SHA=a405d8130cbb24e6556fb0125f634c3fb738eb2a
RUN git clone https://github.com/MLSysOps/MLE-agent.git . \
    && git reset --hard ${COMMIT_SHA} \
    && git submodule update --init --recursive

# Upgrade pip, setuptools and wheel, install dependencies from requirements.txt, then install package in editable mode
RUN pip install --upgrade pip setuptools wheel \
    && if [ -f requirements.txt ]; then pip install -r requirements.txt; fi \
    && pip install -e .

# Fix permissions to avoid potential permission issues
RUN chmod -R a+rwx /testbed

# Ensure virtual environment is activated for interactive shells
RUN echo "source /opt/testbed/bin/activate" >> /root/.bashrc

# Set final working directory
WORKDIR /testbed/
</dockerfile>