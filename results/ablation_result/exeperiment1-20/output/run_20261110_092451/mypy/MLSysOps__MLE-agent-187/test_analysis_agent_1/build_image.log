Using dockerfile:
# Use Ubuntu 20.04 as base image to align with context info and ensure bash availability
FROM --platform=linux/x86_64 ubuntu:20.04

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
SHELL ["/bin/bash", "-c"]

# Install system dependencies required for Python 3.11, git, wget and build tools
RUN apt-get update && apt-get install -y \
        software-properties-common \
        git \
        wget \
        build-essential \
        curl \
        ca-certificates \
        locales \
        tzdata \
        libffi-dev \
        && rm -rf /var/lib/apt/lists/*

# Configure locale for UTF-8 support
RUN locale-gen en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

# Install Python 3.11 and python3-pip via deadsnakes PPA (Ubuntu 20.04 default python3 is 3.8)
RUN add-apt-repository ppa:deadsnakes/ppa -y \
    && apt-get update \
    && apt-get install -y python3.11 python3.11-distutils python3.11-venv python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Update alternatives to use python3.11 as default python3
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

# Upgrade pip for python3.11 and install setuptools, wheel
RUN python3 -m pip install --upgrade pip setuptools wheel

# Create a python virtual environment named testbed and activate it
RUN python3 -m venv /opt/testbed

ENV VIRTUAL_ENV=/opt/testbed
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Clone the repository into /testbed and check out the specific commit (passed as build-arg)
ARG REPO=https://github.com/MLSysOps/MLE-agent.git
ARG COMMIT_SHA=b95f56b446a2fe55247eee717ab85fe45f857d27

RUN git clone ${REPO} /testbed \
    && cd /testbed \
    && git reset --hard ${COMMIT_SHA}

WORKDIR /testbed

# Install the repository itself in editable mode including dependencies
RUN pip install -e .

# Expose environment variables, ensure bashrc activates the virtual environment automatically
RUN echo "source /opt/testbed/bin/activate" >> /root/.bashrc

# Default shell environment: bash with virtualenv activated
ENV SHELL=/bin/bash

