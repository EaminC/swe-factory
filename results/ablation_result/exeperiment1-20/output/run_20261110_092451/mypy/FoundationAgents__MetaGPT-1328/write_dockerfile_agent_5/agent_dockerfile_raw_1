<dockerfile>
# Use official Miniconda3 base image to avoid filesystem permission issues during conda installation
FROM continuumio/miniconda3:latest

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Update and install necessary system dependencies for git, curl, build tools and Python system packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    wget \
    curl \
    build-essential \
    ca-certificates \
    libffi-dev \
    libssl-dev \
    locales \
    python3-venv \
    python3-distutils \
    && rm -rf /var/lib/apt/lists/*

# Create conda environment named 'testbed' with python 3.9
RUN conda create -y -n testbed python=3.9 && conda clean -afy

# Ensure conda environment activation in bashrc for interactive shells
RUN echo "source /opt/conda/etc/profile.d/conda.sh && conda activate testbed" >> /root/.bashrc

ENV PATH=/opt/conda/envs/testbed/bin:$PATH

# Clone repository, checkout the specified commit SHA, and install dependencies from repo only (no pre-install from PyPI)
ARG COMMIT_SHA=5e8bd105177e08848990d32b9ea636daa639be19

RUN git clone https://github.com/geekan/MetaGPT /testbed && \
    cd /testbed && \
    git reset --hard ${COMMIT_SHA} && \
    /bin/bash -c "source /opt/conda/etc/profile.d/conda.sh && conda activate testbed && \
    pip install --upgrade pip setuptools wheel && \
    pip install -e . && \
    pip install -r requirements.txt"

# Set working directory to /testbed
WORKDIR /testbed/

# Use bash as default shell
SHELL ["/bin/bash", "-c"]

# Environment variable to disable openai calls during testing as per context hint
ENV ALLOW_OPENAI_API_CALL=0
</dockerfile>