<dockerfile>
FROM --platform=linux/x86_64 ubuntu:22.04
ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
SHELL ["/bin/bash", "-c"]

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    wget \
    curl \
    build-essential \
    python3.11 \
    python3.11-venv \
    python3.11-distutils \
    python3-pip \
    python3-setuptools \
    locales-all \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Ensure python points to python3.11 and pip is for python3.11
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 \
 && python -m pip install --upgrade pip setuptools

# Install Miniconda for environment management
RUN wget "https://repo.anaconda.com/miniconda/Miniconda3-py311_23.11.0-2-Linux-x86_64.sh" -O /tmp/miniconda.sh \
    && bash /tmp/miniconda.sh -b -p /opt/miniconda3 \
    && rm /tmp/miniconda.sh

ENV PATH=/opt/miniconda3/bin:$PATH

# Initialize conda and create python 3.11 environment named testbed
RUN conda init bash \
 && conda config --set always_yes yes --set changeps1 no \
 && conda create -n testbed python=3.11 \
 && conda clean -afy

# Activate conda environment and install dependencies 
# Clone repo, checkout specific commit, install dependencies via requirements.txt and develop mode
ARG COMMIT_SHA=77126b12032fdf38a35368cfa6d6dd34ab552c10

WORKDIR /testbed

RUN /bin/bash -c "source /opt/miniconda3/etc/profile.d/conda.sh \
    && conda activate testbed \
    && git clone https://github.com/MLSysOps/MLE-agent.git . \
    && git reset --hard ${COMMIT_SHA} \
    && python -m pip install -r requirements.txt \
    && python -m pip install -e ."

# Make sure conda environment is activated by default in bash
RUN echo "source /opt/miniconda3/etc/profile.d/conda.sh && conda activate testbed" >> /root/.bashrc
</dockerfile>