Using dockerfile:
# Use Ubuntu 22.04 as stable base with bash shell and broad package support
FROM --platform=linux/x86_64 ubuntu:22.04
ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Install essential system dependencies: git, python3, python3-venv, pip, curl and locales
RUN apt-get update && apt-get install -y \
    git \
    python3 \
    python3-venv \
    python3-pip \
    curl \
    locales \
    locales-all \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Set locale and timezone environment properly
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# Set working directory
WORKDIR /testbed/

# Clone the repository and checkout the specific commit
RUN git clone https://github.com/AntonOsika/gpt-engineer.git /testbed \
    && git reset --hard f84754d54ee311146c4f52b5e3ceb0fa8d0b731b

# Create and activate a python virtual environment
RUN python3 -m venv /testbed/venv

# Upgrade pip inside venv and install the package in editable mode plus required testing dependencies
RUN /bin/bash -c "source /testbed/venv/bin/activate && \
    pip install --upgrade pip && \
    pip install -e . && \
    pip install pytest"

# Set environment variables for venv activation on container start for interactive use
ENV VIRTUAL_ENV=/testbed/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Default shell to bash
SHELL ["/bin/bash", "-c"]

