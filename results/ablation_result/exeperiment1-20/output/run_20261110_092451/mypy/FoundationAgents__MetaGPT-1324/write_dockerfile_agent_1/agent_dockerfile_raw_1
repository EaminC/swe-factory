<dockerfile>
FROM --platform=linux/x86_64 ubuntu:22.04
ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
SHELL ["/bin/bash", "-c"]

# Install essential system dependencies
RUN apt-get update && apt-get install -y \
    wget \
    git \
    build-essential \
    libffi-dev \
    python3.9 \
    python3.9-venv \
    python3.9-distutils \
    python3-pip \
    curl \
    locales \
    locales-all \
    tzdata \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Ensure python3 points to python3.9
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.9 1
RUN python3 -m pip install --upgrade pip setuptools wheel

# Install Miniconda for environment management
RUN wget https://repo.anaconda.com/miniconda/Miniconda3-py39_23.3.1-0-Linux-x86_64.sh -O /tmp/miniconda.sh \
    && bash /tmp/miniconda.sh -b -p /opt/conda \
    && rm /tmp/miniconda.sh

ENV PATH=/opt/conda/bin:$PATH

# Initialize conda for bash shell
RUN conda init bash

# Create conda environment 'testbed' with python 3.9
# Activate conda environment, clone repo, checkout specific commit, install dependencies with pip in dev mode
ENV REPO_URL=https://github.com/geekan/MetaGPT
ENV REPO_COMMIT=5e8bd105177e08848990d32b9ea636daa639be19
ENV CONDA_ENV=testbed

RUN /bin/bash -c "\
    source /opt/conda/etc/profile.d/conda.sh && \
    conda create -n $CONDA_ENV python=3.9 -y && \
    conda activate $CONDA_ENV && \
    git clone $REPO_URL /testbed && \
    cd /testbed && \
    git checkout $REPO_COMMIT && \
    pip install --upgrade pip setuptools wheel && \
    pip install --upgrade aiohttp==3.8.6 channels==4.0.0 faiss_cpu==1.7.4 fire==0.4.0 typer==0.9.0 lancedb==0.4.0 loguru==0.6.0 meilisearch==0.21.0 'numpy>=1.24.3' 'openai>=1.6.1' beautifulsoup4==4.12.3 pandas==2.1.1 'pydantic>=2.5.3' PyYAML==6.0.1 tqdm==4.66.2 && \
    # install the package in development mode per instructions \
    pip install -e . \
"

# Set working directory
WORKDIR /testbed/

# Persist conda environment activation for interactive shells
RUN echo "source /opt/conda/etc/profile.d/conda.sh && conda activate testbed" >> /root/.bashrc
</dockerfile>