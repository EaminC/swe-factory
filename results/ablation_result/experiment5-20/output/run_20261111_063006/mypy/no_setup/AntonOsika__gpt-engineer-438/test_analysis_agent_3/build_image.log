2026-11-11 06:52:24,781 - INFO - Building image antonosika__gpt-engineer-438
Using dockerfile:
FROM --platform=linux/x86_64 ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

RUN apt-get update && apt-get install -y \
    wget \
    git \
    build-essential \
    python3.10 \
    python3.10-venv \
    python3.10-distutils \
    python3-pip \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN python3.10 -m pip install --upgrade pip setuptools wheel

RUN git clone https://github.com/AntonOsika/gpt-engineer /testbed

WORKDIR /testbed

RUN git reset --hard 2b8e056d5d4d14665b88a01c41356253c94b9259

RUN python3.10 -m venv /testbed/testbed

# Install Poetry pinned to 1.8.5 version to enable 'poetry export'
RUN /bin/bash -c "\
    source /testbed/testbed/bin/activate && \
    pip install 'poetry==1.8.5'"

RUN /bin/bash -c "\
    source /testbed/testbed/bin/activate && \
    poetry export -f requirements.txt --without-hashes -o requirements.txt"

RUN /bin/bash -c "\
    source /testbed/testbed/bin/activate && \
    pip install -r requirements.txt"

RUN /bin/bash -c "\
    source /testbed/testbed/bin/activate && \
    pip install -e ."

ENV OPENAI_API_KEY=""

SHELL ["/bin/bash", "-c"]

