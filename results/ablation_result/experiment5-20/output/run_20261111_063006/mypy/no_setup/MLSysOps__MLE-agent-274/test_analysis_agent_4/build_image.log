Using dockerfile:
# Use Ubuntu 22.04 as base for bash compatibility and stability
FROM --platform=linux/x86_64 ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Install essential tools and libraries for development and runtime
RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    build-essential \
    python3.11 \
    python3.11-venv \
    python3.11-distutils \
    python3-pip \
    python3-setuptools \
    locales-all \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Symlink python and pip to python3.11 and pip3
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/pip pip /usr/bin/pip3 1

# Set bash as the default shell
SHELL ["/bin/bash", "-c"]

# Set working directory
WORKDIR /testbed/

# Clone the target repository and checkout the specific commit
RUN git clone https://github.com/MLSysOps/MLE-agent.git /testbed/ \
    && git reset --hard ea7393b7c5e6009b77bcac00f41dd5dcfd41df7a \
    && git remote remove origin

# Install Python dependencies and the package itself in development mode
RUN pip install --upgrade pip setuptools wheel \
    && pip install --upgrade \
        "py7zr~=0.22.0" \
        "openai~=1.34.0" \
        "tree-sitter==0.21.3" \
        "pandas~=2.2.2" \
        "numexpr~=2.10.1" \
        "bottleneck~=1.4.0" \
        "google-api-python-client~=2.143.0" \
        "google-auth-httplib2~=0.2.0" \
        "google-auth-oauthlib~=1.2.1" \
        "lancedb~=0.15.0" \
        "tantivy~=0.22.0" \
        rich \
        click \
        pyyaml \
        kaggle \
        fastapi \
        uvicorn \
        requests \
        GitPython \
        onnxruntime \
        questionary \
        tavily-python \
        instructor \
        langfuse \
        setuptools \
    && pip install -e .

# Append environment setup to bashrc for convenience
RUN echo "export PATH=$(python3 -m site --user-base)/bin:\$PATH" >> /root/.bashrc

