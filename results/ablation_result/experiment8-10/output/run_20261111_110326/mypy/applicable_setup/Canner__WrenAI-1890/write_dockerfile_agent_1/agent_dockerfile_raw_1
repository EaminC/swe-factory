<dockerfile>
# Use ubuntu 22.04 as base to have bash and stable environment
FROM --platform=linux/x86_64 ubuntu:22.04
ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
SHELL ["/bin/bash", "-c"]

# Install system dependencies: git, curl, build essentials, python3.12 and tools
RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    build-essential \
    ca-certificates \
    locales \
    tzdata \
    software-properties-common \
    gcc \
    g++ \
    pkg-config \
    libffi-dev \
    libssl-dev \
    python3.12 \
    python3.12-distutils \
    python3.12-venv \
    && rm -rf /var/lib/apt/lists/*

# Set python3 to python3.12
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1

# Install pip for python3.12
RUN curl -sS https://bootstrap.pypa.io/get-pip.py | python3 -

# Install Poetry (pin to 1.8.3 as per context)
RUN curl -sSL https://install.python-poetry.org | POETRY_VERSION=1.8.3 python3 -

ENV PATH="/root/.local/bin:$PATH"

WORKDIR /testbed/

# Clone the repository and checkout the specified commit
# ARG to pass commit sha at build time
ARG COMMIT_SHA
RUN git clone https://github.com/Canner/WrenAI.git /testbed && \
    git reset --hard $COMMIT_SHA

# Install project dependencies via Poetry in a virtual environment
# Poetry config to create virtualenv in the project folder for clarity
RUN poetry config virtualenvs.in-project true

# Install dependencies without the eval group (per ci commands)
RUN poetry install --without eval

# Install the project itself in editable/development mode
RUN /bin/bash -c "source /testbed/.venv/bin/activate && cd /testbed && poetry run pip install -e ."

# Set environment variable to activate poetry virtualenv by default in bash
RUN echo "source /testbed/.venv/bin/activate" >> /root/.bashrc

# Set working directory
WORKDIR /testbed/
</dockerfile>