Using dockerfile:
# Base image specification. Ubuntu 22.04 with bash
FROM --platform=linux/x86_64 ubuntu:22.04
ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
SHELL ["/bin/bash", "-c"]

# Install system dependencies: git, python3.12, python3-pip, python3-venv, locales, curl, build essentials, tzdata
RUN apt update && apt install -y \
    git \
    curl \
    build-essential \
    locales \
    locales-all \
    tzdata \
    software-properties-common \
    ca-certificates \
    wget \
    python3.12 \
    python3.12-venv \
    python3.12-distutils \
    python3-pip \
    python-is-python3 \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip for python3.12 explicitly
RUN python3.12 -m pip install --upgrade pip

# Set working directory
WORKDIR /testbed/

# Clone the repository and checkout the specific commit SHA (passed during build)
ARG COMMIT_SHA=ca4141564f86dd1b7dee3082959042dc05d5d471
RUN git clone https://github.com/Aider-AI/aider.git . &&\
    git reset --hard $COMMIT_SHA &&\
    git remote remove origin

# Create and activate virtual environment, install dependencies and the project in editable mode
RUN python3.12 -m venv ./testbed-venv && \
    source ./testbed-venv/bin/activate && \
    pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt && \
    # install dev dependencies including pytest (requirements-dev.txt contains pytest not listed in requirements.txt)
    pip install -r requirements/requirements-dev.txt && \
    pip install -e .

# Add virtualenv activation to bashrc for convenience
RUN echo "source /testbed/testbed-venv/bin/activate" >> /root/.bashrc

# Default workdir and shell are already set

