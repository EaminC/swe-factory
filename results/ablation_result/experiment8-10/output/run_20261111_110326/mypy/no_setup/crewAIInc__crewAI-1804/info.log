    "json-repair>=0.25.2",
    "auth0-python>=4.7.1",
    "litellm>=1.44.22",
    "pyvis>=0.3.2",
    "uv>=0.4.25",
    "tomli-w>=1.1.0",
    "tomli>=2.0.2",
    "chromadb>=0.5.23",
    "pdfplumber>=0.11.4",
    "openpyxl>=3.1.5",
    "blinker>=1.9.0",
]

[project.urls]
Homepage = "https://crewai.com"
Documentation = "https://docs.crewai.com"
