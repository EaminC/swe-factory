Using dockerfile:
# Use Ubuntu 22.04 base image with bash available
FROM --platform=linux/x86_64 ubuntu:22.04
ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
SHELL ["/bin/bash", "-c"]

# Install system dependencies and essential tools
RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    build-essential \
    python3.11 \
    python3.11-venv \
    python3.11-distutils \
    python3-pip \
    locales \
    locales-all \
    ca-certificates \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Set python3 and pip3 alternatives to python3.11
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/pip3 pip3 /usr/bin/pip3 1

# Upgrade pip
RUN python3 -m pip install --upgrade pip

# Install uv tool globally (as it is referenced in docs for env setup)
RUN pip3 install uv

# Create and activate virtual environment named testbed and install dependencies
ENV VIRTUAL_ENV=/opt/testbed
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Clone the repository and checkout the specific commit SHA
RUN git clone https://github.com/crewAIInc/crewAI /testbed \
    && cd /testbed \
    && git reset --hard e655412aca3f7acb9852473b9d336372e635f8ce

WORKDIR /testbed

# Install project dependencies using uv to sync all extras including dev dependencies as per CI and context instructions
RUN uv sync --dev --all-extras

# Install the current repository in editable mode to make local code modifications effective
RUN pip install -e .

# Install optional tools if desired as suggested in the context
RUN pip install "crewai[tools]"

# Add a convenience step to activate the virtual environment by default on bash login
RUN echo "source $VIRTUAL_ENV/bin/activate" >> /root/.bashrc

# Inform about environment variables needed (to be set during docker run or test execution)
ENV OPENAI_API_KEY=""
ENV SERPER_API_KEY=""

# Set working directory for tests and further commands
WORKDIR /testbed

# No test executions inside Dockerfile per instructions

