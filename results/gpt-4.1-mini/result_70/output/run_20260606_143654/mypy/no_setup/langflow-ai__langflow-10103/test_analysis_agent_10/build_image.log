Using dockerfile:
# Use Ubuntu 22.04 as base image for stability and bash shell availability
FROM --platform=linux/x86_64 ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
SHELL ["/bin/bash", "-c"]

# Install essential system dependencies, git, curl, python3.10, pip, nodejs 22.x, npm 10.x, and build tools
RUN apt-get update && apt-get install -y \
    git \
    curl \
    build-essential \
    python3.10 \
    python3.10-venv \
    python3.10-distutils \
    wget \
    ca-certificates \
    locales \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# Setup locales to avoid locale warnings/errors
RUN locale-gen en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

# Install pip for python3.10
RUN curl -sS https://bootstrap.pypa.io/get-pip.py | python3.10

# Install Node.js 22.x LTS and npm 10.x from NodeSource official repository
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g npm@10.9.0 \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and setuptools globally
RUN python3.10 -m pip install --upgrade pip setuptools

# Install pipx for isolated CLI tool management
RUN python3.10 -m pip install pipx

ENV PATH="/root/.local/bin:$PATH"

# Install 'uv' CLI tool via pipx to satisfy the Makefile dependency on uv command
RUN pipx install uv==0.7.20

# Set working directory and clone the repository
WORKDIR /testbed/
RUN git clone https://github.com/langflow-ai/langflow.git . \
    && git reset --hard 58efe809d4dad3decc833afd2f29b9a1038f6d5c

# Create Python virtual environment inside the repository directory
RUN python3.10 -m venv /testbed/testbed

# Upgrade pip and setuptools inside the virtual environment
RUN /testbed/testbed/bin/pip install --upgrade pip setuptools

# Use the virtual environment to run make init and install the repository in editable mode
RUN /bin/bash -c "source /testbed/testbed/bin/activate && make init && pip install -e ."

# Use uv commands inside the virtual environment to sync dependencies and install pre-commit hooks
RUN /bin/bash -c "source /testbed/testbed/bin/activate && uv sync --frozen --extra postgresql && uv run pre-commit install"

# Configure container shells to auto-activate the virtual environment on start
RUN echo "source /testbed/testbed/bin/activate" >> /root/.bashrc

ENV PATH="/testbed/testbed/bin:$PATH"

# No ENTRYPOINT or CMD specified; tests to be executed separately post-image build

