2026-06-06 15:33:57,650 - INFO - Building image antonosika__gpt-engineer-720
Using dockerfile:
FROM ubuntu:22.04
ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
SHELL ["/bin/bash", "-c"]

# Install essential system dependencies and tools
RUN apt-get update && apt-get install -y \
    git \
    python3.10 \
    python3.10-venv \
    python3-pip \
    python3.10-distutils \
    curl \
    locales \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Set locale (ensure UTF-8 support)
RUN locale-gen en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

# Set python3.10 as default python
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1 \
    && python --version

# Upgrade pip, setuptools and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Set working directory
WORKDIR /testbed/

# Clone repository and checkout given commit SHA
ARG COMMIT_SHA=2058edb3cfb8764cf642d73035af4bb6c783b7e5
RUN git clone https://github.com/AntonOsika/gpt-engineer.git /testbed/ \
    && cd /testbed/ \
    && git reset --hard ${COMMIT_SHA}

# Create and activate Python virtual environment and install repository plus all dependencies (including langchain) and testing tools
RUN python -m venv /testbed/venv

RUN /bin/bash -c "source /testbed/venv/bin/activate \
    && pip install --upgrade pip setuptools wheel \
    && pip install langchain>=0.0.240 \
    && pip install -e . \
    && pip install pytest pytest-cov"

# Add virtual environment activation to root user's bashrc for convenience
RUN echo "source /testbed/venv/bin/activate" >> /root/.bashrc

# Default shell
ENV SHELL=/bin/bash

