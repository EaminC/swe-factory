2026-06-06 14:54:26,449 - INFO - Building image antonosika__gpt-engineer-720
Using dockerfile:
FROM --platform=linux/x86_64 ubuntu:22.04
ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
SHELL ["/bin/bash", "-c"]

# Install essential system dependencies and tools
RUN apt-get update && apt-get install -y \
    git \
    python3.10 \
    python3.10-venv \
    python3-pip \
    python3.10-distutils \
    curl \
    locales \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Set locale (ensure UTF-8 support)
RUN locale-gen en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

# Setup python3 as default python command
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1 \
    && python --version

# Upgrade pip
RUN python -m pip install --upgrade pip

# Set workdir for the repository
WORKDIR /testbed/

# Clone the repo, checkout specific commit
ARG COMMIT_SHA=2058edb3cfb8764cf642d73035af4bb6c783b7e5
RUN git clone https://github.com/AntonOsika/gpt-engineer.git /testbed/ \
    && cd /testbed/ \
    && git reset --hard ${COMMIT_SHA}

# Create and activate virtual environment, install repo and testing dependencies including langchain and all required dependencies from pyproject.toml
RUN python -m venv /testbed/venv

RUN /bin/bash -c "source /testbed/venv/bin/activate \
    && pip install --upgrade pip setuptools wheel \
    && pip install -e . \
    && pip install pytest pytest-cov"

# Add virtual environment activation to .bashrc for interactive use convenience
RUN echo "source /testbed/venv/bin/activate" >> /root/.bashrc

# Default shell set to bash
ENV SHELL=/bin/bash

