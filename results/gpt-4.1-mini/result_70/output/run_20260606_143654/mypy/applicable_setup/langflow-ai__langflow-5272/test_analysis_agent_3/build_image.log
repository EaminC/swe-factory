2026-06-06 16:28:51,311 - INFO - Building image langflow-ai__langflow-5272
Using dockerfile:
FROM --platform=linux/x86_64 ubuntu:22.04
ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
SHELL ["/bin/bash", "-c"]

# Install essential system packages and dependencies
RUN apt update && apt install -y \
    git \
    curl \
    wget \
    build-essential \
    python3.10 \
    python3.10-venv \
    python3.10-distutils \
    python3-pip \
    locales-all \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Setup python3 alias to python3.10
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1

# Clone the repository first into /testbed
RUN git clone https://github.com/langflow-ai/langflow.git /testbed/
WORKDIR /testbed/
RUN git reset --hard 2a95b52e06769d70fd9f0671cfcc6734ee41f0ef

# Create virtual environment inside /testbed after cloning
RUN python3 -m venv venv

ENV VIRTUAL_ENV=/testbed/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Upgrade pip and install packaging tools inside the venv
RUN pip install --upgrade pip setuptools wheel

# Install Hatch and hatchling as build system is Hatch-based
RUN pip install hatch hatchling

# Install the project's dependencies specified in pyproject.toml with Hatch
RUN hatch env create

# Install the project in editable mode
RUN pip install -e .

# Install uv for CLI commands required by developer setup
RUN pip install "uv>=0.4"

# Install nodejs 22.12 LTS and npm 10.9 as required by developer setup
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
  && apt-get install -y nodejs \
  && npm install -g npm@10.9.0

# Install make utility
RUN apt-get update && apt-get install -y make && rm -rf /var/lib/apt/lists/*

# Ensure environment activation on shell startup
RUN echo "source /testbed/venv/bin/activate" >> /root/.bashrc

WORKDIR /testbed/

