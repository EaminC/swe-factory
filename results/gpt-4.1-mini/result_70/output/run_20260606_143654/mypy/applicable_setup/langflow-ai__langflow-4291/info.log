    "sentence-transformers>=2.3.1",
    "ctransformers>=0.2.10"
]
clickhouse-connect = [
    "clickhouse-connect==0.7.19"
]

[project.scripts]
langflow = "langflow.__main__:main"

[tool.uv]
dev-dependencies = [
