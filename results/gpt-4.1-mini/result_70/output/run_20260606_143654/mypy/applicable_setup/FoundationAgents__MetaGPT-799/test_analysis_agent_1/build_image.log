Using dockerfile:
FROM --platform=linux/x86_64 ubuntu:22.04
ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
SHELL ["/bin/bash", "-c"]

# Install essential system dependencies
RUN apt-get update && apt-get install -y \
    git \
    wget \
    curl \
    bzip2 \
    ca-certificates \
    build-essential \
    libffi-dev \
    locales \
    locales-all \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Install Miniconda for Python environment management
RUN wget --quiet https://repo.anaconda.com/miniconda/Miniconda3-py39_23.7.2-1-Linux-x86_64.sh -O /tmp/miniconda.sh \
    && bash /tmp/miniconda.sh -b -p /opt/miniconda3 \
    && rm /tmp/miniconda.sh
ENV PATH=/opt/miniconda3/bin:$PATH

# Initialize conda and create environment with Python 3.9
RUN conda init bash \
    && conda config --append channels conda-forge \
    && /bin/bash -c "source /opt/miniconda3/etc/profile.d/conda.sh && \
       conda create -n testbed python=3.9 -y"

# Set working directory
WORKDIR /testbed/

# Clone repository and checkout the specific commit, install dependencies in development mode
RUN /bin/bash -c "source /opt/miniconda3/etc/profile.d/conda.sh && \
    conda activate testbed && \
    git clone https://github.com/FoundationAgents/MetaGPT.git /testbed && \
    git reset --hard 59afc5301f55037e7b379497767f4af62fd65b31 && \
    pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt && \
    pip install -e ."

# Ensure conda environment activation on container shell start
RUN echo 'source /opt/miniconda3/etc/profile.d/conda.sh && conda activate testbed' >> /root/.bashrc

