<dockerfile>
# Use Ubuntu 22.04 as stable base with bash and common tooling
FROM --platform=linux/x86_64 ubuntu:22.04
ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Set bash as default shell
SHELL ["/bin/bash", "-c"]

# Install essential system packages including git, python3.10 and tools
RUN apt-get update && apt-get install -y \
    git \
    wget \
    curl \
    build-essential \
    python3.10 \
    python3.10-venv \
    python3.10-distutils \
    python3-pip \
    python3-setuptools \
    python3-wheel \
    && rm -rf /var/lib/apt/lists/*

# Ensure python3 points to python3.10 and pip for python3.10 is default pip
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1 \
    && python3 -m pip install --upgrade pip setuptools wheel==0.45.1

# Create working directory
WORKDIR /testbed/

# Clone repo, checkout specific commit and install dependencies in a virtual environment
ARG REPO=https://github.com/agentscope-ai/agentscope.git
ARG COMMIT_SHA=f44b10fcf8d88b2be1cb4474598bf5875242d21d

RUN git clone ${REPO} . \
    && git checkout ${COMMIT_SHA}

# Create Python venv named testbed and install dependencies
RUN python3 -m venv /testbed/.venv

# Activate venv and install dependencies using dev install with extras in editable mode
RUN source /testbed/.venv/bin/activate \
    && pip install --upgrade pip setuptools==78.1.1 wheel==0.45.1 \
    && pip install -e ".[dev]" \
    && pip install coverage pytest

# Set environment variables placeholders (empty by default)
ENV DASHSCOPE_API_KEY=""
ENV GAODE_API_KEY=""

# Make sure environment activates when bash shell is used, for interactive test runs
RUN echo "source /testbed/.venv/bin/activate" >> /root/.bashrc

# Set working directory to /testbed for test execution
WORKDIR /testbed/
</dockerfile>