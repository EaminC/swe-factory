<script>
#!/bin/bash
set -uxo pipefail
cd /testbed

git checkout c96d4a6823fb5a3ef196427612b784efe504fdce "tests/cli/test_utils.py"

# Apply test patch
git apply -v - <<'EOF_114329324912'
[CONTENT OF TEST PATCH]
