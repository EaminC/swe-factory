+class _NotSpecified:
+    def __repr__(self):
+        return "NOT_SPECIFIED"
+
+
+# Sentinel value used to detect when no value has been explicitly provided.
+# Unlike `None`, which might be a valid value from the user, `NOT_SPECIFIED` allows
