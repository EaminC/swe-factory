langflow = { workspace = true }

[tool.uv.workspace]
members = ["src/backend/base", "."]

[tool.hatch.build.targets.wheel]
packages = ["src/backend/langflow"]

[project]
name = "langflow"
version = "1.1.1"
description = "A Python package with a built-in web application"
