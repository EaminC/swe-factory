    "httpx>=0.27.0,<1.0.0",  # For testing FastAPI endpoints
]
dev = [
    "mypy>=1.15.0,<2.0.0",
    "tox>=4.0.0,<5.0.0",
]
vectorstore = [
    "sentence-transformers>=4.1.0,<5.0.0",
    "chromadb>=0.4.22,<2.0.0",
    "posthog<6.0.0",
]

[project.urls]
