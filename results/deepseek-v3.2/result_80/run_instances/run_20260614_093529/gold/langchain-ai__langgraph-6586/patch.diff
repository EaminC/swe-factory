diff --git a/libs/langgraph/langgraph/types.py b/libs/langgraph/langgraph/types.py
--- a/libs/langgraph/langgraph/types.py
+++ b/libs/langgraph/langgraph/types.py
@@ -56,6 +56,7 @@ class ToolOutputMixin:  # type: ignore[no-redef]
     "Durability",
     "interrupt",
     "Overwrite",
+    "ensure_valid_checkpointer",
 )
 
 Durability = Literal["sync", "async", "exit"]
@@ -73,6 +74,20 @@ class ToolOutputMixin:  # type: ignore[no-redef]
 - False disables checkpointing, even if the parent graph has a checkpointer.
 - None inherits checkpointer from the parent graph."""
 
+
+def ensure_valid_checkpointer(checkpointer: Checkpointer) -> Checkpointer:
+    if checkpointer not in (None, True, False) and not isinstance(
+        checkpointer, BaseCheckpointSaver
+    ):
+        raise TypeError(
+            "Invalid checkpointer provided. Expected an instance of "
+            "`BaseCheckpointSaver`, `True`, `False`, or `None`. "
+            f"Received {type(checkpointer).__name__!s}. "
+            "Pass a proper saver (e.g., InMemorySaver, AsyncPostgresSaver)."
+        )
+    return checkpointer
+
+
 StreamMode = Literal[
     "values", "updates", "checkpoints", "tasks", "debug", "messages", "custom"
 ]
